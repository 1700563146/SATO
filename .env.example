# 环境变量示例：全部可选，复制成 .env 才会生效（.env 已被 .gitignore 忽略）
#
# 站点语言（默认 zh_CN，可选 zh_TW / en / ja / ko / ru）
# PUBLIC_SITE_LANG=zh_CN
#
# 页面开关：覆盖 src/config/siteConfig.ts 里 pages 的同名项，值是 true / false
# 适合在部署平台（Vercel / Cloudflare）上按环境开关页面，不用改代码
# PUBLIC_PAGES_FRIENDS=true
# PUBLIC_PAGES_GUESTBOOK=true
# PUBLIC_PAGES_DYNAMIC=true
# PUBLIC_PAGES_PROJECTS=true
# PUBLIC_PAGES_GALLERY=true
# PUBLIC_PAGES_BOOKNAV=true
# PUBLIC_PAGES_BILIBILI=false
# PUBLIC_PAGES_BANGUMI=false
# PUBLIC_PAGES_VNDB=false
# PUBLIC_PAGES_MAL=false
# PUBLIC_PAGES_SPONSOR=false
#
# 显示设置面板（主题色 / 星空 / 指针光晕 等开关）：默认关闭以减小首屏体积
# PUBLIC_DISPLAY_SETTINGS=true
#
# 构建期用 Cloudflare Workers 适配器（astro.config.mjs 里的 cloudflare adapter）
# CF_WORKERS=1
#
# GitHub 卡片（正文里的 github 指令）构建时要拉取仓库信息，可提高 API 限额
# GITHUB_TOKEN=github_pat_xxx
#
# 音乐曲库同步（pnpm music:sync）
# MUSIC_SOURCE=meting          # 强制走 Meting，忽略 musicConfig.mode
# MUSIC_PLAYLIST=123456789     # 临时指定歌单 id 或链接
# MUSIC_OFFLINE=10             # 下载前 10 首音频到 public/music/audio/
#
# 照片墙批量压缩（pnpm wall:opt）
# WALL_MAX_EDGE=1600
# WALL_QUALITY=78
# WALL_OUT=public/wall
